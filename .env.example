# Career-Ops Environment Configuration
# Copy this file to .env and fill in your values

# OpenAI API Configuration (required)
# Get your key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-proj-your-key-here

# OpenAI Model Configuration
OPENAI_MODEL=gpt-4o
OPENAI_MAX_TOKENS=8192
OPENAI_TEMPERATURE=0.7

# Application Configuration
NODE_ENV=production
PORT=3000
LOG_LEVEL=info

# Career-Ops Paths
CAREER_OPS_DATA_DIR=/app/data
CAREER_OPS_REPORTS_DIR=/app/reports
CAREER_OPS_OUTPUT_DIR=/app/output
CAREER_OPS_CONFIG_DIR=/app/config

# Playwright Configuration
PLAYWRIGHT_HEADLESS=true
PLAYWRIGHT_BROWSERS_PATH=/ms-playwright

# Batch Processing
BATCH_PARALLEL=1
BATCH_MAX_RETRIES=2

# Dashboard (optional)
DASHBOARD_ENABLED=true
DASHBOARD_PORT=8080

# Rate Limiting (requests per minute)
RATE_LIMIT_RPM=60

# Bright Data Web Unlocker (optional - for bypassing bot protection)
# Sign up at: https://brightdata.com/
BRIGHTDATA_HOST=brd.superproxy.io
BRIGHTDATA_PORT=33335
BRIGHTDATA_USERNAME=brd-customer-xxx-zone-yyy
BRIGHTDATA_PASSWORD=your-password

# Optional: Custom instructions file
# CUSTOM_MODES_DIR=/app/custom-modes