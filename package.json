    "@fastify/cors": "^10.0.1",
    "@fastify/rate-limit": "^10.2.0",
    "@fastify/static": "^8.0.3",
    "fastify": "^5.2.0",
    "js-yaml": "^4.1.0",
    "openai": "^4.82.0",
    "pdf-parse": "^2.4.5",
    "pino": "^9.5.0",
    "pino-pretty": "^13.0.0",
    "playwright": "^1.58.1"
